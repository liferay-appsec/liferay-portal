@component-name = "portal-security"
definition {

	property ci.retries.disabled = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "LDAP";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			PortalSettings.tearDownAuthenticationCP();

			PagesAdmin.tearDownCP();
		}
	}

	@description = "This is a use case for LPD-23115. Localizable String custom fields can be imported from and exported to LDAP."
	@priority = 3
	test AttributesCanBeImportedIntoLocalizableStringCustomUserMappings {
		property apacheds.enabled = "true";
		property test.liferay.virtual.instance = "false";
		property test.run.type = "single";

		task ("Given: User adds Custom Localizable Text Field to User object") {
			takeScreenshot();
			CustomFields.openCustomFieldAdmin();
			takeScreenshot();
			CustomFields.addCP(
				customFieldName = "User Custom Field",
				customFieldType = "Text Area",
				customInputDataType = "Text",
				localization = "true",
				resourceName = "User");
			takeScreenshot();
		}

		task ("And: User adds LDAP server with userCustomMapping and configure settings with group import method") {
			var enableSettingList = "enabled,ldapImportEnabled,ldapExportEnabled";

			LDAP.addLDAPServerAndTestConnection(userCustomMappings = "user custom field=title");
			takeScreenshot();
			LDAP.enableLDAPSettings(enableSettingList = ${enableSettingList});
			takeScreenshot();
		}

		task ("And: creates a new user on LDAP with attribute and imports it") {
			LDAP.installLDAPCommandUtil();
			takeScreenshot();
			LDAP.importLDIFOnLDAPAndTriggerSync(ldifName = "addUserWithAttribute");
			takeScreenshot();
			LDAP.verifyUserFirstNameIsChangedInLDAP(userFirstName = "attribute");
			takeScreenshot();
			LDAP.verifyUserIsImported(userScreenName = "testUser");
			takeScreenshot();
		}

		task ("When: Admin changes new user custom field") {
			User.openUsersAdmin();
			takeScreenshot();

			UserNavigator.gotoUser(userScreenName = "testuser");
			takeScreenshot();

			User.viewUserCustomFieldsCP(
				customFieldName = "User Custom Field",
				customFieldType = "Text Area",
				startingValue = "attribute");
			takeScreenshot();



			User.editUserInformation(
				userCustomField = "Updated Custom Field",
				userCustomFieldLabel = "user custom field",
				userCustomFieldType = "Text Area");
			takeScreenshot();

			Pause(value1 = 5000);

			User.viewUserCustomFieldsCP(
				customFieldName = "User Custom Field",
				customFieldType = "Text Area",
				startingValue = "Updated Custom Field");

			Pause(value1 = 5000);
		}

		task ("Then: The new user information will be present in the LDAP database") {
			LDAP.verifyUserFirstNameIsChangedInLDAP(userFirstName = "Updated Custom Field");
		}
	}

}