Bundle-Name: Liferay Portal Security Audit Wiring
Bundle-SymbolicName: com.liferay.portal.security.audit.wiring
Bundle-Version: 6.0.13
Require-Capability:\
	osgi.extender;\
		filter := "(&(osgi.extender=osgi.configurator)(version>=1.0)(!(version>=2.0)))"
-includeresource: OSGI-INF/configurator=configurator