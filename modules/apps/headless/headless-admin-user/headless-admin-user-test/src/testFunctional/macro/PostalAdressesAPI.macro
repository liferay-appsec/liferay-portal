definition{

    @summary = "/v1.0/postal-addresses/{postalAddressId}"
    macro getPostalAddress(postalAddressId = null) {
        Variables.assertDefined(parameterList = ${postalAddressId});

            var request = PostalAddressesAPI._curlSetupHeader(
                postalAddressId = ${postalAddressId},
                domain = ${domain},
                port = ${port},
                printHeader = ${printHeader},
                virtualHost = ${virtualHost}
            );

            return JSONCurlUtil.delete(${request});
    }

    @summary = "/v1.0/user-accounts/{userAccountId}/postal-addresses"
    macro getPostalAddressesOfUser(userId =null) {
    //macro getPostalAddresses(userId =null) {

        Variables.assertDefined(parameterList = ${userId});

        var request = PostalAddressesAPI._curlSetupHeader(
            userId = ${userId},
            domain = ${domain},
			port = ${port},
			printHeader = ${printHeader},
			virtualHost = ${virtualHost}
        );

        return JSONCurlUtil.get(${request});
    }

    @summary = "/v1.0/accounts/{accountId}/postal-addresses"
    macro getPostalAddresses(accountId = null) {
    //macro getPostalAddressesOfAccount(accountId = null) {

        Variables.assertDefined(parameterList = ${accountId});

        var request = PostalAddressesAPI._curlSetupHeader(
            accountId = ${accountId},
            domain = ${domain},
			port = ${port},
			printHeader = ${printHeader},
			virtualHost = ${virtualHost}
        );

        return JSONCurlUtil.get(${request});
    }

    @summary = "/v1.0/organizations/{organizationId}/postal-addresses"
    macro getPostalAddressOfOrganization(organizationId = null) {
    //macro getPostalAddressOfOrganization(organizationId = null) {
        Variables.assertDefined(parameterList = ${organizationId});

        var request = PostalAddressesAPI._curlSetupHeader(
            organizationId = ${organizationId},
            domain = ${domain},
			port = ${port},
			printHeader = ${printHeader},
			virtualHost = ${virtualHost}
        );

        return JSONCurlUtil.get(${request});
    }

    @summary = "/v1.0/postal-addresses/{postalAddressId}"
    macro deletePostalAddress(postalAddressId = null) {
            Variables.assertDefined(parameterList = ${postalAddressId});

            var request = PostalAddressesAPI._curlSetupHeader(
                postalAddressId = ${postalAddressId},
                domain = ${domain},
                port = ${port},
                printHeader = ${printHeader},
                virtualHost = ${virtualHost}
            );

            return JSONCurlUtil.delete(${request});
    }

    @summary = "/v1.0/postal-addresses/{postalAddressId}. In this case all fields are optional as any can be updated."
    macro updatePostalAddress(optionalFields = null) {
        Variables.verifyDefined(parameterList = ${postalAddressId});

                var header = PostalAddressesAPI._curlSetupHeader(
                    postalAddressId = ${postalAddressId},
                    domain = ${domain},
                    port = ${port},
                    printHeader = ${printHeader},
                    virtualHost = ${virtualHost}
                );

                var body = PostalAddressesAPI._curlSetupBody(optionalFields = ${optionalFields});

                var request = StringUtil.add(${header}, ${body}, " ");

                return JSONCurlUtil.put(${request});
    }

    @summary = "/v1.0/postal-addresses/{postalAddressId}"
    macro recreatePostalAddress(postalAddressId = null, addressCountry = null, addressLocality = null, addressType = null, addressName = null, postalCode = null, primaryAddress = null, addressRegion = null, streetAddressLine1 = null){
        Variables.verifyDefined(parameterList = "${postalAddressId},${addressCountry},${addressLocality},${addressType},${addressName},${postalCode},${primaryAddress},${addressRegion},${streetAddressLine1}");

        var header = PostalAddressesAPI._curlSetupHeader(
            postalAddressId = ${postalAddressId},
            domain = ${domain},
			port = ${port},
			printHeader = ${printHeader},
			virtualHost = ${virtualHost}
        );

        var body = PostalAddressesAPI._curlSetupBody(mandatoryFields = '''
                "addressCountry": "${addressCountry}",
                "addressLocality": "${addressLocality}",
                "addressRegion": "${addressRegion}",
                "addressType": "${addressType}",
                "name": "${addressName}",
                "postalCode": "${postalCode}",
                "primary": ${primaryAddress},
                "streetAddressLine1": "${streetAddressLine1}"
            ''',
            optionalFields = ${optionalFields}
        );

        var request = StringUtil.add(${header}, ${body}, " ");

        return JSONCurlUtil.put(${request});
    }

    @summary = "/v1.0/accounts/{accountId}/postal-addresses"
    macro createPostalAddress(accountId = nul, addressCountry = null, addressLocality = null, addressType = null, addressName = null, postalCode = null, primaryAddress = null, addressRegion = null, streetAddressLine1 = null){
        Variables.assertDefined(parameterList = "${accountId},${addressCountry},${addressLocality},${addressType},${addressName},${postalCode},${primaryAddress},${addressRegion},${streetAddressLine1}");

        var header = PostalAddressesAPI._curlSetupHeader(
            accountId = ${accountId},
            domain = ${domain},
			port = ${port},
			printHeader = ${printHeader},
			virtualHost = ${virtualHost}
        );

        var body = PostalAddressesAPI._curlSetupBody(mandatoryFields = '''
                "addressCountry": "${addressCountry}",
                "addressLocality": "${addressLocality}",
                "addressType": "${addressType}",
                "name": "${addressName}",
                "postalCode": "${postalCode}",
                "primary": ${primaryAddress},
                "addressRegion": "${addressRegion}",
                "streetAddressLine1": "${streetAddressLine1}"
            ''',
            optionalFields = ${optionalFields}
        );

        var request = StringUtil.add(${header}, ${body}, " ");

        return JSONCurlUtil.post(${request});
    }

    @summary=""
    macro _curlSetupHeader(accountId = null, userId =null, postalAdressId = null, organizationId = null, additionalResources = null, domain = null, virtualHost = null, port = null, printHeader = null, requestParams = null){
        if (isSet(virtualHost)) {
			if (!(isSet(port))) {
				var port = 8080;
			}

			var portalURL = "http://${virtualHost}:${port}";
		}

        if (!(isSet(domain))) {
			var domain = "liferay.com";
		}

        if(isSet(postalAddressId)){
            var api = "postal-addresses/${postalAdressId}";
        }
        else if (isSet(accountId)){
            var api = "accounts/${accountId}/postal-addresses";
        }
        else if (isSet(userId)){
            var api = "user-accounts/${userId}/postal-addresses";
        }
        else if(isSet(${organizationId})){
            var api = "organizations/${organizationId}/postal-addresses";
        }
        else{ 
            var api="postal-addresses";
        }

        if(isSet(additionalResources)){
            var api = StringUtil.concat(${api}, "/${additionalResources}");
        }

        if (isSet(requestParams)) {
			var api = StringUtil.concat(${api}, "?${requestParams}");
		}

        var header = '''
			${portalURL}/o/headless-admin-user/v1.0/${api} \
				-u test@${domain}:test \
				-H accept: application/json \
				-H Content-Type: application/json
		''';

        if (isSet(printHeader) && (${printHeader} == "true")) {
			var header = StringUtil.concat(${header}, " -i ");
		}

        return ${header};
    }

    @summary = ""
    macro _curlSetupBody(mandatoryFields = null, optionalFields = null){
		var bodyValues = "";

		if (isSet(mandatoryFields)) {
			var bodyValues = StringUtil.concat(${mandatoryFields});
		}

		if (isSet(optionalFields)) {
			if (isSet(mandatoryFields)) {
				var bodyValues = StringUtil.concat(", ");
			}

			var bodyValues = StringUtil.concat(${optionalFields});
		}

		var body = "-d {${bodyValues}}";

		return ${body};
	}
}