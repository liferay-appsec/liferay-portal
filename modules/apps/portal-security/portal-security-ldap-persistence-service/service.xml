<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="false" dependency-injector="ds" mvcc-enabled="true" package-path="com.liferay.portal.security.ldap.persistence">
	<namespace>LDAP</namespace>
	<entity local-service="true" name="LDAPServerAttributeRel" remote-service="false">

		<!-- PK fields -->

		<column name="ldapServerAttributeRelId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />

		<!-- Other fields -->

		<column name="ldapServerId" type="long" />
		<column name="classNameId" type="long" />
		<column name="classPK" type="long" />

		<!-- Finder methods -->

		<finder name="LdapServerId" return-type="Collection">
			<finder-column name="ldapServerId" />
		</finder>
		<finder name="L_C" return-type="Collection">
			<finder-column name="ldapServerId" />
			<finder-column name="classNameId" />
		</finder>
		<finder name="C_C" return-type="Collection">
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
		</finder>
		<finder name="L_C_C" return-type="LDAPServerAttributeRel" unique="true">
			<finder-column name="ldapServerId" />
			<finder-column name="classNameId" />
			<finder-column name="classPK" />
		</finder>
	</entity>
	<exceptions>
	</exceptions>
</service-builder>