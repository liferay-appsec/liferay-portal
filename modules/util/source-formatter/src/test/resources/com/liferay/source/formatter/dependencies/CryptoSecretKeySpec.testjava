package com.liferay.source.formatter.dependencies;

import com.liferay.portal.kernel.security.crypto.CryptoUtil;

import java.security.Key;

import java.util.function.Function;

import javax.crypto.spec.SecretKeySpec;

/**
 * @author Rafael Praxedes
 */
public class CryptoSecretKeySpec {

	public Function<byte[], String> getFunction() {
		return String::new;
	}

	public Key getKey(byte[] keyBytes) throws Exception {
		return CryptoUtil.createSecretKey("HmacSHA256", keyBytes);
	}

	public SecretKeySpec getSecretKeySpec(byte[] keyBytes) {
		return new SecretKeySpec(keyBytes, "HmacSHA256");
	}

}